{
  "name": "insurance-semantic-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate": "tsx scripts/validate.ts",
    "test": "tsx --test tests/*.test.ts",
    "report": "tsx scripts/report.ts",
    "format": "prettier --write src scripts tests vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "decimal.js": "^10.6.0",
    "elkjs": "^0.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
